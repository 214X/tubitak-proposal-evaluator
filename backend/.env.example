# --- Mail bildirim (SMTP) ayarları ---
# Bu değerler boş/false iken gerçek mail GÖNDERİLMEZ; rapor maili + PDF
# runtime/outbox/<session_id>/ altına yazılır (testable fallback).
#
# Gerçek gönderim için SMTP_ENABLED=true yapın ve sağlayıcı bilgilerini doldurun.
# Gmail örneği: 2FA açıp bir "App Password" üretin (normal şifre çalışmaz).

SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=ornek@gmail.com
SMTP_PASSWORD=uretilen-app-password
SMTP_FROM_ADDRESS=ornek@gmail.com
SMTP_FROM_NAME=TÜBİTAK Değerlendirme Sistemi
